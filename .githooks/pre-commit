#!/bin/sh
# brimm.ai pre-commit (24 Oct 2026, founder 16:45): the site shows no price or currency amount — tools/no-prices.js (self-test first, so the
# check cannot be blinded silently). A fresh clone runs: git config core.hooksPath .githooks
node tools/no-prices.js --self-test || exit 1
node tools/no-prices.js || exit 1
# The visa guide pages (25 Oct 2026, founder 08:50): no visa verdict written on a page — the answer only comes from the live check —
# tools/no-verdicts.js (self-test first, the same file brimm-ai's tools/visa-pages/build.js checks every page with before writing it).
node tools/no-verdicts.js --self-test || exit 1
node tools/no-verdicts.js || exit 1
# No provider name a visitor can reach (28 Oct 2026, founder 23:27) — every served file, comments included; _config.yml keeps the
# tooling (these guards) off the site. tools/no-providers.js, self-test first.
node tools/no-providers.js --self-test || exit 1
node tools/no-providers.js || exit 1
# The visa answer cannot be switched on before the site hides what the app hides (1 Nov 2026, #487): tools/check-switch.js, self-test first.
node tools/check-switch.js --self-test || exit 1
node tools/check-switch.js || exit 1
# Every file a page loads carries its own fingerprint (1 Nov 2026, HQ #94: a phone kept an old image under the same name): an unstamped
# or stale /assets address cannot be committed, whichever tool wrote the page. tools/stamp-assets.js, self-test first.
node tools/stamp-assets.js --self-test || exit 1
node tools/stamp-assets.js --check || exit 1
# Every page names its own address once, and the sitemap lists only those addresses (10 Nov 2026, HQ #946: Search Console's
# "Duplicate without user-selected canonical"): tools/check-canonicals.js, self-test first.
node tools/check-canonicals.js --self-test || exit 1
node tools/check-canonicals.js || exit 1
